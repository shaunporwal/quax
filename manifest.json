{
    "manifest_version": 3,
    "name": "W2 Autofill Widget",
    "version": "1.0",
    "description": "Parse your local W2 PDF and autofill related fields on websites without storing data.",
    "permissions": [
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "pdf.worker.js",
                "pdf.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
